# Keep provider calls disabled until the AI enablement gate is complete.
AI_PROVIDER=none

# Planned per-IP request limit for the API.
RATE_LIMIT_PER_MIN=30

# Set to the exact deployment origin in production, without a trailing slash.
# Leave blank locally to use the request host.
APP_ORIGIN=

# Reserved for an eligible provider after the AI enablement gate.
# AI_API_KEY=
# AI_MODEL=

# For local development with the temporary catalog, set CATALOG_SEED=1 in .env.local and run npm run dev.
# For local unit tests with the temporary catalog, run npm run test:seed.
# Production builds and CI always require the full catalog.
# CATALOG_SEED=0
# Set this to the deployment origin to run Playwright against a deployed app.
# PLAYWRIGHT_BASE_URL=
